{
  "name": "codemirror-lean4-lsp",
  "version": "0.1.0",
  "description": "Lean 4 language support and LSP integration for CodeMirror 6",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ejgallego/lean-mirror.git"
  },
  "homepage": "https://github.com/ejgallego/lean-mirror#readme",
  "bugs": {
    "url": "https://github.com/ejgallego/lean-mirror/issues"
  },
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "codemirror",
    "codemirror6",
    "lean",
    "lean4",
    "lsp",
    "proof-assistant"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "undici": "7.28.0"
  },
  "packageManager": "npm@11.11.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codemirror": {
      "types": "./dist/codemirror.d.ts",
      "import": "./dist/codemirror.js"
    },
    "./infoview": {
      "types": "./dist/infoview.d.ts",
      "import": "./dist/infoview.js"
    },
    "./infoview.css": "./dist/infoview.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "codemirror": [
        "./dist/codemirror.d.ts"
      ],
      "infoview": [
        "./dist/infoview.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:example:minimal": "vite build --config ./examples/minimal/vite.config.ts",
    "build:platform": "npm run build -w @leanprover/editor-platform",
    "build:vscode": "npm run build:platform && npm run build -w @leanprover/editor-platform-vscode",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:platform": "npm run check -w @leanprover/editor-platform",
    "check:vscode": "npm run check -w @leanprover/editor-platform-vscode",
    "ci": "npm run check && npm run check:platform && npm run check:vscode && npm test && npm run test:platform && npm run test:consumer:verso && npm run test:vscode && npm run test:e2e && npm run test:e2e:minimal && npm run build:example:minimal && npm run test:consumer && npm run build:vscode && npm run pack:check && npm run test:packed",
    "demo": "node ./scripts/run-demo.mjs",
    "demo:backend": "node ./demo/server.mjs",
    "demo:frontend": "vite --config ./demo/vite.config.ts",
    "demo:reset": "node ./scripts/reset-demo-workspace.mjs",
    "demo:zerocopy-anneal": "node ./scripts/run-zerocopy-anneal-demo.mjs",
    "example:minimal": "node ./scripts/run-minimal-example.mjs",
    "pack:check": "node ./scripts/verify-pack.mjs",
    "playwright:install": "node ./scripts/install-playwright.mjs",
    "prepublishOnly": "npm run check && npm test && npm run test:consumer && npm run pack:check && npm run test:packed",
    "test": "vitest run",
    "test:consumer": "npm run build && node ./test/package-consumer.mjs",
    "test:consumer:verso": "npm run test:verso-contract -w @leanprover/editor-platform",
    "test:consumer:verso:workspace": "node ./scripts/test-verso-consumer.mjs",
    "test:packed": "npm run build && node ./scripts/test-packed-consumer.mjs",
    "test:platform": "npm run test -w @leanprover/editor-platform",
    "test:vscode": "npm run test -w @leanprover/editor-platform-vscode",
    "test:e2e": "node ./scripts/test-e2e.mjs",
    "test:e2e:minimal": "node ./scripts/test-minimal-example-e2e.mjs",
    "test:e2e:zerocopy-anneal": "node ./scripts/test-zerocopy-anneal-e2e.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lsp-client": "6.2.5",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "peerDependencies": {
    "@leanprover/infoview": "^0.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@leanprover/infoview": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@leanprover/editor-platform": "file:packages/editor-platform",
    "@leanprover/infoview": "^0.13.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "jsdom": "^29.1.1",
    "marked": "^15.0.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
