{
  "name": "codemirror-lean4-lsp",
  "version": "0.1.0",
  "description": "Lean 4 language support and LSP integration for CodeMirror 6",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "codemirror",
    "codemirror6",
    "lean",
    "lean4",
    "lsp",
    "proof-assistant"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "ci": "npm run check && npm test && npm run test:e2e && npm run build",
    "demo": "node ./scripts/run-demo.mjs",
    "demo:backend": "node ./demo/server.mjs",
    "demo:frontend": "vite --config ./demo/vite.config.ts",
    "playwright:install": "node ./scripts/install-playwright.mjs",
    "prepublishOnly": "npm run check && npm test && npm run build",
    "test": "vitest run",
    "test:e2e": "node ./scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/lsp-client": "^6.2.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/stream-parser": "^0.19.9",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "ws": "^8.20.0"
  }
}
